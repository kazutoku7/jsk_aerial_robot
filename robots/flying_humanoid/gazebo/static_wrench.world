<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- The robot occupies x >= 0. The visible face and contact surface are
         at x=0, matching the optimizer's wall plane and +x wall normal. -->
    <model name="static_wrench_wall">
      <static>true</static>
      <pose>-0.01 0 0.75 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box><size>0.02 1.2 1.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.7</mu><mu2>0.7</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.02 1.2 1.5</size></box>
          </geometry>
          <transparency>0.35</transparency>
          <material>
            <ambient>0.35 0.45 0.55 1</ambient>
            <diffuse>0.35 0.45 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
