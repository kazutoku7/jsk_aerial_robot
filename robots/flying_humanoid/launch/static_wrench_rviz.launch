<?xml version="1.0"?>
<launch>
  <arg name="airframe" default="tri_single_arm_v1" />
  <arg name="robot_ns" default="flying_humanoid" />
  <arg name="robot_model" default="$(find flying_humanoid)/robots/$(arg airframe)/robot.urdf.xacro" />
  <arg name="ee_offset" default="0.05" />
  <arg name="ee_axis" default="[1, 0, 0]" />
  <arg name="offset_id" default="$(eval '{:.3f}m'.format(float(arg('ee_offset'))))" />
  <arg name="axis_id" default="$(eval arg('ee_axis').strip('[]').replace(',', '_').replace(' ', ''))" />
  <arg name="result_root" default="$(find flying_humanoid)/results/static_wrench" />
  <arg name="result_dir" default="$(arg result_root)/offset_$(arg offset_id)" />
  <arg name="result" default="$(arg result_dir)/axis_$(arg axis_id).yaml" />
  <arg name="rviz_config" default="$(find flying_humanoid)/config/rviz_config" />
  <arg name="headless" default="false" />

  <group ns="$(arg robot_ns)">
    <param name="robot_description"
           command="$(find xacro)/xacro --inorder $(arg robot_model) robot_name:=$(arg robot_ns)" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="static_wrench_robot_state_publisher">
      <param name="tf_prefix" value="$(arg robot_ns)" />
    </node>
    <node pkg="flying_humanoid" type="visualize_static_wrench_result.py"
          name="static_wrench_result_visualizer" output="screen">
      <param name="result" value="$(arg result)" />
      <param name="tf_prefix" value="$(arg robot_ns)" />
    </node>
  </group>

  <node pkg="rviz" type="rviz" name="static_wrench_rviz" args="-d $(arg rviz_config)"
        unless="$(arg headless)" />
</launch>
